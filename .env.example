# =============================================================================
# KhetiGPT Backend - Environment Variable Template
# -----------------------------------------------------------------------------
# HOW TO USE:
#   1. Copy this file:            cp .env.example .env
#   2. Replace every placeholder below with your own value.
#   3. NEVER commit the real .env file. It is already listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# "development" enables verbose error details, "production" hides them.
NODE_ENV=development
# Port the Express server listens on. Render provides this automatically.
PORT=5000
# Public base URL of this backend (used inside error/log messages only).
API_BASE_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# Frontend origins allowed by CORS
# -----------------------------------------------------------------------------
# Comma separated list. No spaces, no trailing slash.
# Local dev example:
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Production example:
# CORS_ORIGIN=https://khetigpt-frontend.vercel.app

# -----------------------------------------------------------------------------
# MongoDB Atlas
# -----------------------------------------------------------------------------
# Atlas -> Database -> Connect -> Drivers -> copy the connection string.
# Replace <password> with the real database user password.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/khetigpt?retryWrites=true&w=majority
# Name used when the connection string has no database in it.
MONGODB_DB_NAME=khetigpt

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_min_32_characters
# Token lifetime. Examples: 1d, 12h, 7d
JWT_EXPIRES_IN=1d
# Bcrypt password hashing cost (10-12 is a good range).
BCRYPT_SALT_ROUNDS=10

# -----------------------------------------------------------------------------
# Google Gemini API (AI farming assistant)
# -----------------------------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey  (this is NOT a Google Cloud project key)
GEMINI_API_KEY=replace_with_your_gemini_api_key
# Currently supported fast text model. Do not use deprecated gemini-1.0/1.5 models.
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# OpenWeather API (weather information)
# -----------------------------------------------------------------------------
# Free key from https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=replace_with_your_openweather_api_key
OPENWEATHER_BASE_URL=https://api.openweathermap.org

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Window length in minutes and max requests per window per IP.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
# Stricter limit applied to the AI endpoint because it costs API credits.
AI_RATE_LIMIT_WINDOW_MINUTES=15
AI_RATE_LIMIT_MAX_REQUESTS=30
